# 부하 테스트 환경변수 예시.
# 이 파일을 .env.loadtest 로 복사해서 값을 채운다. (.env.loadtest 는 gitignore 대상)
#
#   cp load-test/.env.loadtest.example load-test/.env.loadtest
#   set -a && . load-test/.env.loadtest && set +a
#
# k6는 .env 파일을 읽지 않는다. 위처럼 셸에 export 하거나 -e 로 하나씩 넘긴다.

# ── 측정 경로 ────────────────────────────────────────────────────────────────
# gateway = 게이트웨이 통과(JWT 서명). 사용자가 겪는 end-to-end 수치.
# direct  = 서비스 직접 호출(X-User-Id). 프록시 구간을 빼고 서비스 자체만 잰다.
# 회차마다 둘 다 재고, 차이를 게이트웨이 비용으로 기록한다.
TARGET=gateway

# TARGET=gateway 일 때 쓰는 주소.
# NKS 클러스터 주소를 넣지 말 것 — LB 트래픽 과금 + 팀 dev 환경 마비.
BASE_URL=http://localhost:8080

# TARGET=direct 일 때 쓰는 주소.
MAP_URL=http://localhost:8083
PLACE_URL=http://localhost:8082
USER_URL=http://localhost:8081

# ── 인증 ─────────────────────────────────────────────────────────────────────
# 테스트 전용 JWT 시크릿. HS256이라 32자 이상이어야 한다.
# 운영/dev 의 JWT_SECRET 을 절대 가져다 쓰지 말 것. 아무 임의 문자열이면 된다.
# 게이트웨이에 넣는 값과 같아야 한다. TARGET=direct 면 필요 없다.
JWT_SECRET=

# ── 시드 규모 ────────────────────────────────────────────────────────────────
# load-test/seed/seed.sql 의 \set 값과 반드시 일치시킨다.
# 어긋나면 없는 id를 조회해 404·빈 응답만 재게 되는데, 그건 항상 빠르다.
SEED_USER_COUNT=5000
SEED_MAP_COUNT=7000
SEED_COMMUNITY_MAP_COUNT=5000
SEED_MEMBERS_PER_MAP=6

# ── 부하량 ───────────────────────────────────────────────────────────────────
# 목표 부하(초당 요청 수). MODE=probe 로 knee 를 구한 뒤 채운다.
#   평상 = knee x 0.5 / 스트레스·스파이크·지속은 스크립트가 이 값에서 계산한다.
TARGET_RPS=
