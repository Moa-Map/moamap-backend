# 로컬 개발용 환경변수 템플릿.
# 이 파일을 복사해 루트에 .env를 만들고 값을 채운다. (.env는 gitignore 대상)
# spring-dotenv가 부팅 시 루트 .env를 읽는다. 실제 환경변수가 .env보다 우선한다.
# 주의: 빈 값(KEY=)은 yml 기본값을 빈 문자열로 덮어쓴다. 안 쓸 키는 .env에서 줄을 지우거나 주석 처리한다.

### user-service: 카카오 로그인 ###
KAKAO_APP_ID=

# 카카오 REST API 키
KAKAO_REST_API_KEY=

### map-service: 서울 열린데이터광장 API ###
SEOUL_API_KEY=

# 혼잡도 동기화 주기(ms). 기본값은 300000(5분) — 기본값으로 쓸 거면 이 줄을 지운다.
CONGESTION_SYNC_INTERVAL_MS=3600000

# Gemini API 키
GEMINI_API_KEY=
# 사용할 Gemini 모델 ID
GEMINI_MODEL_ID=
