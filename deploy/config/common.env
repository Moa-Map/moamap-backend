# dev·prod 공통, 비밀 아닌 설정. 비밀·apply 후에 정해지는 값은 SSM /moamap/<env>/ 에 있다.
TZ=Asia/Seoul

USER_SERVICE_URL=http://user-service:8081
MAP_SERVICE_URL=http://map-service:8083
PLACE_SERVICE_URL=http://place-service:8082

REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=moamap
DB_USERNAME=moamap

OBJECT_STORAGE_REGION=ap-northeast-2

# Google 로그인. client ID는 앱에 공개되는 값. iOS, Web(Android 토큰의 aud) 순.
GOOGLE_ENABLED=true
GOOGLE_CLIENT_IDS=481427766287-airpbbn9mt841nrl8iplhii4lj4s9h4d.apps.googleusercontent.com,481427766287-818l56rttj5fvc7209kc0e5rdsebdqvn.apps.googleusercontent.com

# Apple 로그인. 개인키·암호화 키는 SSM(APPLE_PRIVATE_KEY, APPLE_CREDENTIAL_KEY_V1).
APPLE_ENABLED=true
APPLE_CLIENT_ID=com.moamap.MoaMap
APPLE_TEAM_ID=A4BC8YG62N
APPLE_KEY_ID=KF57XKT8QM
