COMPOSE_PROFILES=localdb
DB_URL=jdbc:postgresql://postgres:5432/moamap

PUBLIC_GATEWAY_URL=https://api-dev.moamap.co.kr

# 개발용 카카오 로그인 콜백. 카카오 콘솔 Redirect URI에 같은 값이 등록돼 있어야 한다.
DEV_LOGIN_ENABLED=true
KAKAO_REDIRECT_URI=https://api-dev.moamap.co.kr/api/v1/auth/test/kakao/callback

# 유동인구 혼잡도 동기화 주기 — 테스트 중 호출량을 줄이려고 1시간 (기본 5분).
CONGESTION_SYNC_INTERVAL_MS=3600000
