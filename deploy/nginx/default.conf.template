# nginx 공식 이미지가 기동 시 ${ORIGIN_VERIFY_SECRET}만 치환한다(정의된 환경변수만 치환 → $host 등은 그대로).
server {
    listen 80;
    client_max_body_size 20m;

    # CloudFront IP는 모든 AWS 고객이 공유한다. 우리 배포만 아는 값으로 한 번 더 거른다.
    if ($http_x_origin_verify != "${ORIGIN_VERIFY_SECRET}") {
        return 403;
    }

    # 배포 때 gateway 컨테이너가 새로 만들어지면 IP가 바뀐다. 고정 주소로 두면 nginx가 시작 시 IP를 박아 502가 난다
    # → Docker 내장 DNS로 매번 다시 조회한다(proxy_pass에 변수를 쓰면 resolver를 거친다).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway http://gateway-service:8080;

    location / {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Origin-Verify "";
        proxy_read_timeout 60s;
    }
}
