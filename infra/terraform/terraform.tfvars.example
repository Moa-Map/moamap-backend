# 이 파일을 terraform.tfvars로 복사해 값을 채운다. (terraform.tfvars는 gitignore 대상 — 커밋 금지)
# REPLACE_ME 항목은 NHN Cloud 콘솔에서 확인해 채운다.

region = "KR1"

# 네트워크 (기본값 사용 가능)
vpc_cidr    = "10.0.0.0/16"
subnet_cidr = "10.0.1.0/24"

# NKS
kube_tag          = "v1.32.3"
availability_zone = "kr-pub-a"
node_count        = 2

flavor_id           = "REPLACE_ME_flavor_id"
node_image_id       = "REPLACE_ME_node_image_id"
keypair_name        = "REPLACE_ME_keypair_name"
external_network_id = "REPLACE_ME_external_network_id"
external_subnet_id  = "REPLACE_ME_external_subnet_id"
